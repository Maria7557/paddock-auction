{
  "version": 1,
  "functions": {
    "/_middleware": {
      "runtime": "nodejs",
      "matchers": [
        {
          "regexp": "^(?:\\/(_next\\/data\\/[^/]{1,}))?(?:\\/((?!_next|.*\\..*).*))(\\.json)?[\\/#\\?]?$",
          "originalSource": "/((?!_next|.*\\..*).*)"
        }
      ]
    },
    "/api/auth/token": {},
    "/api/seller/vehicles/media/[batchId]/[fileName]": {},
    "/api/seller/vehicles/upload-photos": {}
  }
}